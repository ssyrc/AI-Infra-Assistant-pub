# 부트스트랩 값만 담는다. vLLM 주소·리랭커·검색 파라미터 등 운영 중 바뀌는 값은
# 관리자 콘솔 '설정' 탭에서 관리한다(platform_config DB).
#
# DB/Redis 접속 정보는 여기 값으로부터 db-init이 자동으로 DSN을 만들어 주입하므로,
# 비밀번호를 바꾸면 각 MCP의 DSN도 자동으로 갱신된다(SQL에 하드코딩하지 않음).
#
# 아래 모든 CHANGE_ME는 배포 전 반드시 실제 값으로 교체할 것.
# 생성 예: openssl rand -base64 32  /  openssl rand -hex 32 (ENCRYPTION_KEY)

# --- 컨테이너 이미지 레지스트리 (폐쇄망: 사내 미러) ---
# 비우면 공개 레지스트리(docker.io / ghcr.io)를 쓴다. 폐쇄망은 아래처럼 사내 미러로 지정.
# 이미지가 <REGISTRY_DOCKERHUB>/<원래 docker hub 경로>, <REGISTRY_GHCR>/<원래 ghcr 경로> 로 참조됨.
REGISTRY_DOCKERHUB=pypi.example.com/proxy-docker-registry-1.docker.io
REGISTRY_GHCR=pypi.example.com/proxy-docker-ghcr.io

# --- pip 빌드 설정 (폐쇄망: 사내 PyPI 미러 + 프록시) ---
# 값은 사내 pip.conf(index-url / proxy / trusted-host)와 '똑같이' 맞춘다.
PIP_INDEX_URL=http://pypi.example.com/repository/proxy-pypi-files.pythonhosted.org/simple
PIP_TRUSTED_HOST=pypi.example.com
BUILD_PROXY=http://10.0.0.241:3128
# 사내 pip.conf에 no_proxy가 없으면(=미러도 프록시를 통해 접근) 여기도 localhost만 둔다.
# 반대로 미러를 프록시 없이 직접 접근해야 하면 pypi.example.com를 추가한다.
NO_PROXY=localhost,127.0.0.1

# --- apt 빌드 설정 (폐쇄망: 사내 Debian 미러 + 위 BUILD_PROXY 경유) ---
# MCP 이미지가 openssh-client를 설치할 때 deb.debian.org 대신 이 미러를 사용한다.
# 컨테이너의 /etc/os-release에서 VERSION_CODENAME(trixie/bookworm/bullseye 등)을 읽어 자동 적용한다.
APT_MIRROR=http://pypi.example.com/repository/proxy-apt-mirror.kakao.com-debian
APT_HTTP_TIMEOUT=10
#
# ⚠️ 빌드 중 JSONDecodeError(Expecting value: line 1 column 1)가 나면 프록시 문제가 아니다.
#    최신 pip(24.x)가 JSON Simple API(PEP 691)로 미러를 조회하는데 사내 미러가 이를 지원하지 않아
#    응답을 json.loads()하다 깨지는 것이다.
#    → vendor/pip-*.whl(HTML API만 쓰는 pip<22.2)을 각 Dockerfile이 오프라인으로 먼저 설치해
#      해결한다. 이 리포에는 vendor/pip-22.1.2-py3-none-any.whl이 이미 포함돼 있다(추가 작업 불필요).
#    베이스 이미지는 python:3.11-slim-bullseye (옛 pip는 3.12에서 pkgutil.ImpImporter 에러로 못 돎).
#    자세한 건 docs/RUN-LOG.md 참고.

# --- 호스트 공개 포트 (충돌 시에만 변경) ---
# 컨테이너 내부 포트는 고정이고, 여기 값은 '호스트에 노출되는' 포트만 바꾼다.
# 사용 중인 포트 확인:  ss -tlnp | grep -E ':(85[0-9]{2})\b'
# 8080/8100/8200/3000/3001/5432는 다른 서비스와 자주 충돌해서 쓰지 않는다.
# 8500번부터 순서대로 하나씩 배정한다(컨테이너 내부 포트는 도커 내부망 전용이라 무관).
AGENT_PORT=8500
ADMIN_PORT=8501
OPENWEBUI_PORT=8502
MANUAL_MCP_PORT=8503
COMMAND_MCP_PORT=8504
VOC_MCP_PORT=8505
SYSTEM_MCP_PORT=8506
PG_PORT=8507
LANGFUSE_PORT=8509
# mock-vllm은 기본적으로 호스트에 노출하지 않는다(dev 내부망 전용). 직접 디버깅이 필요할 때만
# docker-compose.dev.yml의 mock-vllm ports 주석을 풀고 빈 포트를 지정한다(기본 8508).

# --- PostgreSQL ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=CHANGE_ME_pg_password

# --- 주소류 부트스트랩 (여기서 한 번에 관리) ---
# 최초 기동 시 platform_settings에 주입되는 기본값. 이후 운영 중 변경은 관리자 콘솔 '설정' 탭에서.
# GPU 서버(vLLM)·리랭커·스케줄러 주소를 배포 환경에 맞게 바꾼다.
VLLM_LLM_BASE_URL=http://CHANGE-ME:8000/v1
VLLM_LLM_MODEL=qwen3-32b
VLLM_EMBED_BASE_URL=http://CHANGE-ME:8010/v1
VLLM_EMBED_MODEL=bge-m3
EMBED_DIM=1024
RERANK_PROVIDER=tei
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3

# 커맨드를 실행할 서버(로그인 서버). **이름이 아니라 IP로 적는다** - 이름은 배포 호스트의
# /etc/hosts에 의존하는데, 실제로 login-01이 엉뚱한 IP로 풀려 모든 실행이 인증 실패했다.
EXECUTION_HOST=10.0.0.100

# 권한 강등 방식: su-login(기본) | su | runuser  — 어느 쪽이든 호출자 본인 계정으로 내려갑니다.
# 차이는 커맨드 하나당 고정 비용입니다.
#   su-login  `su - <계정> -c` 로그인 셸. 원격 프로필을 매번 읽어 실측 약 2초.
#   su        프로필을 안 읽습니다(PATH가 기본값).
#   runuser   PAM 인증·프로필을 모두 건너뜁니다. 보통 제일 빠릅니다(util-linux, 없으면 127 실패).
# **먼저 재 보고 바꾸세요**: bash scripts/bench-exec.sh <계정> "<실제 커맨드>"
# 실제 커맨드가 정상 출력되는 것 중 가장 빠른 값을 넣습니다.
SSH_PRIVDROP=su-login

# 사용자가 브라우저로 접속하는 Open WebUI 주소(안내용). 콘솔이 API를 부르는
# openwebui_base_url(도커 내부 8080)과는 다른 값이다.
OPENWEBUI_PUBLIC_URL=http://10.0.0.30:8502

# 관리자 콘솔 "서버 파일에서 선택" 업로드용 호스트 폴더(admin-console 컨테이너의 /data/uploads로
# 마운트됨, 읽기전용). 하위 폴더는 콘솔 설정 탭의 upload_source_dir로 재시작 없이 좁힐 수 있다.
UPLOAD_SOURCE_HOST_DIR=/home/users/ops.user/deploy/datasets

# --- System/Command MCP 원격 실행(ssh) ---
# 대상 서버에 root로 접속 가능한 개인키 경로(호스트 경로). 대상 서버들의 IP는 이 호스트의
# /etc/hosts에 등록돼 있어야 한다(예: `10.0.0.100  login05`). 컨테이너에 :ro로 마운트된다.
# 이 배포 호스트의 root가 대상 서버(게이트/로그인 서버)에 ssh-copy-id 해둔 '실제 개인키 파일'을
# 가리켜야 한다. 없는 경로를 적으면 docker가 그 자리에 빈 디렉토리를 만들고, 컨테이너 안에서
# ssh -i 가 항상 인증 실패한다(서버에서 직접 ssh는 되는데 에이전트만 안 되는 증상).
# 실제 배포 호스트(10.0.0.30)에서는 /root/.ssh/id_ed25519 다. 이 값이 compose 기본값이라
# .env가 없어도 동작하지만, 다른 경로를 쓰면 여기서 바꾼다.
#   확인: ls -l /root/.ssh/id_*
#   컨테이너: docker compose -f docker-compose.dev.yml exec execution-mcp ls -l /root/.ssh/id_ed25519
SSH_KEY_PATH=/root/.ssh/id_ed25519

# --- 관리자 콘솔 인증 (reverse proxy로 접근망 제한 필수) ---
ADMIN_USER=CHANGE_ME_admin_id
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Redis (임베딩 캐시 + Langfuse 큐) ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- agent-server -> Langfuse 트레이싱 (키를 비우면 트레이싱 비활성화) ---
# 아래 키는 langfuse-web의 LANGFUSE_INIT_*로 자동 생성되는 값과 동일해야 한다.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME

# --- Langfuse v3 인프라 ---
LANGFUSE_NEXTAUTH_URL=http://localhost:8509
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_nextauth_secret
LANGFUSE_SALT=CHANGE_ME_salt
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_from_openssl_rand_hex_32
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_password
MINIO_PASSWORD=CHANGE_ME_minio_password
